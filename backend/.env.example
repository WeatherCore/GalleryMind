# ============================================================
# LLM 模型配置（Agent 推理 + 视觉描述）
# ============================================================
# OpenAI 兼容接口（保底默认）：客户端走 OpenAI 兼容协议，任何兼容服务都能接
# 只填下面两项，Agent 和 Vision 会共用；要分开配就填下面的 AGENT_LLM_* / VISION_LLM_*
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Agent 推理模型（负责工具调度与最终回答）----------
# 需要支持 function calling；不填回退到 OPENAI_API_KEY / OPENAI_BASE_URL
AGENT_LLM_MODEL=qwen3.5-omni-flash
AGENT_LLM_API_KEY=sk-your-dashscope-key-here
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- Vision 视觉模型（describe_image 工具用，需支持多模态图片输入）----------
# 不填回退到 OPENAI_API_KEY / OPENAI_BASE_URL
VISION_LLM_MODEL=qwen3.5-omni-plus-2026-03-15
VISION_LLM_API_KEY=sk-your-dashscope-key-here
VISION_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 其他可选模型示例：
#   OpenAI 官方:  model=gpt-4o   base_url=https://api.openai.com/v1
#   DeepSeek:     model=deepseek-chat  base_url=https://api.deepseek.com/v1
#   通义千问:     model=qwen-max / qwen-plus  base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
#   GLM (智谱):   model=glm-4-flash  base_url=https://open.bigmodel.cn/api/paas/v4
#   本地 Ollama:  model=qwen2.5:7b  base_url=http://localhost:11434/v1  api_key=ollama


# ============================================================
# Milvus 向量数据库配置
# ============================================================
# Milvus 服务地址，用于存储和检索向量索引
# 本地部署默认使用：http://localhost:19530
# 使用 Milvus Lite 可以使用文件路径，例如：./milvus_demo.db
MILVUS_URI=http://localhost:19530


# ============================================================
# ModelScope 模型缓存目录（可选）
# ============================================================
# 从 ModelScope 下载的 Qwen3-VL 模型文件（Embedding + Reranker）存放位置
# 不设置则默认使用 backend/data/models
MODELSCOPE_CACHE=./backend/data/models


# ============================================================
# 图片库路径（可选）
# ============================================================
# 被检索的图片库目录，扫描 .png/.jpg/.jpeg/.gif
# 不设置则默认使用 backend/data/images
IMAGE_DIR=./backend/data/images


# ============================================================
# 开发开关（可选）
# ============================================================
# 设为 true 时跳过模型加载，直接返回预设假数据，用于纯前端开发与 CI 联调
# 启动示例：USE_MOCK_DATA=true python -m backend.main
USE_MOCK_DATA=false